# Reference only: export these variables in the shell before launching.
# The launcher does not source .env files. Do not commit secrets.
SDN_DEFENSE_ENV=development
SDN_DEFENSE_LOG_LEVEL=INFO
SDN_DEFENSE_SEED=2026

# Loopback-only synthetic review demo. No live networking is started.
SDN_DEMO_HOST=127.0.0.1
SDN_DEMO_PORT=18000
SDN_DASHBOARD_PORT=5173
SDN_DEMO_DATABASE=var/demo.sqlite3
SDN_DEMO_CORS_ORIGIN=http://127.0.0.1:5173

# Live feature flags remain disabled until the documented evidence gates pass.
SDN_DEFENSE_ENABLE_LIVE_NETWORK=false
SDN_DEFENSE_ENABLE_MITIGATION=false

# Stage 2 local-only SDN defaults. The explicit test rule remains disabled.
SDN_STAGE2_CONTROLLER_HOST=127.0.0.1
SDN_STAGE2_CONTROLLER_PORT=6653
SDN_STAGE2_MONITOR_INTERVAL_SECONDS=2.0
SDN_RYU_STATUS_FILE=var/runtime/ryu-status.json
SDN_RYU_STATUS_STALE_AFTER_SECONDS=6.0
# Engineering default only; set explicitly for any reviewed collection protocol.
SDN_STAGE2_MAX_FEATURE_GAP_SECONDS=30.0
SDN_STAGE2_INSTALL_TEST_RULE=false
SDN_STAGE2_TEST_RULE_COOKIE=0x534432
SDN_STAGE2_TEST_RULE_PRIORITY=100
SDN_STAGE2_TEST_RULE_IDLE_TIMEOUT_SECONDS=120
SDN_STAGE2_TEST_RULE_SOURCE_IP=10.0.0.1
SDN_STAGE2_TEST_RULE_DESTINATION_IP=10.0.0.3
SDN_STAGE2_TEST_RULE_TCP_PORT=18080
SDN_STAGE2_TEST_RULE_EGRESS_PORT=3
